DATABASE_URL=postgres://email:email@localhost:5432/email_scheduler?sslmode=disable
REDIS_URL=redis://localhost:6379
# API_PORT=4000
# Fake SMTP accounts (create at https://ethereal.email/create) — format: email:pass, comma separated
# ETHEREAL_ACCOUNTS=user1@ethereal.email:pass1,user2@ethereal.email:pass2
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587

# Throughput controls (see DESIGN.md §9)
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# Web / OAuth (Google Cloud console -> OAuth client ID, redirect: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=generate-with-openssl-rand-base32
NEXT_PUBLIC_API_URL=http://localhost:4000
